[:: Token tag start len]

// 1. Direct record constructor
[! t1 [Token 10 20 30]]
[. "Direct ctor:" [@@.Token:tag t1] [@@.Token:start t1] [@@.Token:len t1]]

// 2. Hash-prefixed constructor
[! t2 [#Token 40 50 60]]
[. "Hash ctor:" [@@.Token:tag t2] [@@.Token:start t2] [@@.Token:len t2]]

// 3. Spaced hash constructor
[! t3 [# Token 70 80 90]]
[. "Spaced ctor:" [@@.Token:tag t3] [@@.Token:start t3] [@@.Token:len t3]]

// 4. Bulk record setter on array
[! tokens [H [* 3 Token.bytes]]]
[@@!.Token tokens 0 111 222 333]
[@@!.Token tokens 1 444 555 666]
[@@!.Token tokens 2 777 888 999]
[. "Array bulk:" [@@.Token:tag tokens 1] [@@.Token:start tokens 1] [@@.Token:len tokens 1]]

// 5. Bulk record setter on single pointer
[! p [H Token.bytes]]
[@@!.Token p 987 654 321]
[. "Single bulk:" [@@.Token:tag p] [@@.Token:start p] [@@.Token:len p]]

// 6. Native string slicing
[! msg "Hello, Antigravity AI Compiler!"]
[! s1 [/ msg 0 5]]
[! s2 [/ msg 7 11]]
[! s3 [/ msg 19 11]]
[. "Slice 1:" s1]
[. "Slice 2:" s2]
[. "Slice 3:" s3]

// 7. Stack-spilled parameters (>6 parameters)
[: sum8 [a b c d e f g h] [D
  [^ [+ [+ [+ [+ [+ [+ [+ a b] c] d] e] f] g] h]]
]]
[! s8 [sum8 1 2 3 4 5 6 7 8]]
[. "Sum 8:" s8]

// 8. -O1 spill edge case: 8 live locals vs a 4-register pool.
// With -O1, four get callee-saved registers and the rest spill to stack slots;
// the answer must equal the -O0 result exactly (expected sum 36).
[: eight_live [] [D
  [! a 1]
  [! b 2]
  [! c 3]
  [! d 4]
  [! e 5]
  [! f 6]
  [! g 7]
  [! h 8]
  [^ [+ [+ [+ [+ [+ [+ [+ a b] c] d] e] f] g] h]]
]]
[! eight_sum [eight_live]]
[. "Eight live:" eight_sum]


