// test_stage8.aic - verification harness for Stage 8: statement emission
// (compile_stmt ported to AIC), built on top of Stage 7's complete
// expression emitter.
//
// emit_stmt dispatches off the SAME classify_op1..4 codes emit_expr's
// dual-role '?' already relies on - code 2='!', 3='?', 4='W', 5='D',
// 6='^', 7-12=byte/word ops. Anything else is resolved via the SAME
// resolve_func name-table scan emit_expr uses for calls (factored out
// here so both share one implementation rather than two copies that could
// drift, the way new_label_num silently going missing did last time).
//
// Byte/word ops and function calls need NO new code at statement level:
// aic_codegen.py's own compile_stmt just calls compile_expr(node) for
// both and drops the result, so emit_stmt delegates to emit_byte_op/
// emit_word_op/emit_call directly - the exact same instructions, not
// merely "equivalent" ones. What emit_stmt must NOT do is fall through to
// binop_classify the way emit_expr's fallback does: a bare `[+ 1 2]` at
// statement position is invalid (compile_stmt's own final `else: raise`),
// so a statement head that resolves to neither a builtin nor a function
// name is reported as unsupported, never silently compiled as a binop.
//
// Driver change from Stage 7: main's statement walk now calls emit_stmt
// on every mains[] entry directly (any statement type), not just '!'
// forms - declared-name COLLECTION still only scans for immediate
// top-level '!' forms (a deliberate simplification: Stage 6's own
// recurse_stmt/collect_reads in compiler.aic already proves deep-body
// declaration collection works, so this harness's test source keeps every
// variable's first '!' at main's top level and only reassigns inside
// nested W/? bodies, rather than re-deriving that recursion here too).
//
// ctx grows one more slot (7: epilogue label pointer) so '^' can be
// tested in isolation - the way aic_codegen.py's own compile_main sets
// self.epilogue = None (main never returns) and compile_function sets it
// to f".Lret_{name}" per function, ctx[7] is set once by the driver
// before compiling whichever statement contains the '^' under test, not
// derived from an actual per-function frame (that's Stage 9's job:
// compile_main/compile_function/build - the layer that actually
// allocates per-function slot tables and wraps bodies in a real
// prologue/epilogue, which this harness still bypasses entirely, exactly
// as every prior stage in this series bypassed Analyzer.analyze's type
// pass and called compile_expr/compile_stmt directly).
//
// Scope of this increment, stated honestly: '!', '^' (tested standalone,
// not inside a real compiled function), '?', 'W', 'D', and bare
// byte/word-op/call statements. Deliberately NOT covered: '.' (print -
// needs per-expression static typing to pick the STR vs INT format
// string, not yet ported), libc ops as statements (their own expression
// codegen doesn't exist yet either - Stage 7 explicitly deferred them),
// and real per-function frames (prologue/epilogue/param copy-in/frame
// sizing - Stage 9).

[§ is_space [b] [^ [|| [== b 32] [|| [== b 9] [|| [== b 10] [== b 13]]]]]]
[§ is_atom_char [b] [^ [== [|| [is_space b] [|| [== b 91] [|| [== b 93] [== b 34]]]] 0]]]
[§ write_token [[$ tokens] idx tag start len] [D [@@! tokens [* idx 3] tag] [@@! tokens [+ [* idx 3] 1] start] [@@! tokens [+ [* idx 3] 2] len] [^ idx]]]
[§ is_section [[$ tokens] [$ src] t] [D [! tg [@@ tokens [* t 3]]] [! st [@@ tokens [+ [* t 3] 1]]] [! ln [@@ tokens [+ [* t 3] 2]]] [^ [&& [== tg 3] [&& [== ln 2] [&& [== [@ src st] 194] [== [@ src [+ st 1]] 167]]]]]]]
[§ [$ slice_str] [[$ src] start len] [D [! buf [H len]] [! k 0] [W [< k len] [D [@! buf k [@ src [+ start k]]] [! k [+ k 1]]]] [^ buf]]]
[§ streq [[$ src] s1 l1 s2 l2] [D [! ok 1] [? [!= l1 l2] [! ok 0] [D]] [! k 0] [W [&& ok [< k l1]] [D [? [!= [@ src [+ s1 k]] [@ src [+ s2 k]]] [! ok 0] [D]] [! k [+ k 1]]]] [^ ok]]]
[§ decl_add [[$ src] [$ recs] count start len] [D [! i 0] [! found 0] [W [&& [== found 0] [< i count]] [D [? [streq src [@@ recs [* i 2]] [@@ recs [+ [* i 2] 1]] start len] [! found 1] [D]] [! i [+ i 1]]]] [? found [D] [D [@@! recs [* count 2] start] [@@! recs [+ [* count 2] 1] len] [! count [+ count 1]]]] [^ count]]]

// --- new for stage 7 -------------------------------------------------------
[§ decl_index [[$ src] [$ recs] count start len] [D [! i 0] [! result -1] [W [&& [== result -1] [< i count]] [D [? [streq src [@@ recs [* i 2]] [@@ recs [+ [* i 2] 1]] start len] [! result i] [D]] [! i [+ i 1]]]] [^ result]]]

[§ strlt [[$ src] s1 l1 s2 l2] [D [! minlen [? [< l1 l2] l1 l2]] [! i 0] [! result -1] [W [&& [== result -1] [< i minlen]] [D [! b1 [@ src [+ s1 i]]] [! b2 [@ src [+ s2 i]]] [? [< b1 b2] [! result 1] [? [> b1 b2] [! result 0] [D]]] [! i [+ i 1]]]] [? [== result -1] [! result [? [< l1 l2] 1 0]] [D]] [^ result]]]

[§ sort_decls [[$ src] [$ recs] lo hi] [D [! i lo] [W [< i hi] [D [! minidx i] [! j [+ i 1]] [W [< j hi] [D [? [strlt src [@@ recs [* j 2]] [@@ recs [+ [* j 2] 1]] [@@ recs [* minidx 2]] [@@ recs [+ [* minidx 2] 1]]] [! minidx j] [D]] [! j [+ j 1]]]] [? [!= minidx i] [D [! ts [@@ recs [* minidx 2]]] [! tl [@@ recs [+ [* minidx 2] 1]]] [@@! recs [* minidx 2] [@@ recs [* i 2]]] [@@! recs [+ [* minidx 2] 1] [@@ recs [+ [* i 2] 1]]] [@@! recs [* i 2] ts] [@@! recs [+ [* i 2] 1] tl]] [D]] [! i [+ i 1]]]] [^ 0]]]

[§ is_numeric_atom [[$ src] start len] [D [! b0 [@ src start]] [! b1 [? [> len 1] [@ src [+ start 1]] 0]] [^ [|| [&& [>= b0 48] [<= b0 57]] [&& [== b0 45] [&& [> len 1] [&& [>= b1 48] [<= b1 57]]]]]]]]

[§ next_child_end [[$ tokens] [$ match] p] [^ [? [== [@@ tokens [* p 3]] 1] [@@ match p] p]]]

// count_params: number of top-level children in a function's param list -
// [po, match[po]] - walking with next_child_end the same way every other
// child-walk in this codebase does. Only the COUNT is needed here (which
// argument register each position lands in); stage 4's fuller param
// parsing in compiler.aic (name/type per param) isn't needed for a call
// site, only for compiling the callee's own body - out of scope here.
[§ count_params [[$ tokens] [$ match] po] [D [! pc [@@ match po]] [! p [+ po 1]] [! n 0] [W [< p pc] [D [! p [+ [next_child_end tokens match p] 1]] [! n [+ n 1]]]] [^ n]]]

// argreg_name: SysV integer-argument register for position i (0-5),
// matching aic_codegen.py's _ARG_REGS exactly. All branches return a
// string literal, so this satisfies the same "both branches same type"
// rule '?'-as-a-value enforces on itself.
[§ argreg_name [i] [^ [? [== i 0] "%rdi" [? [== i 1] "%rsi" [? [== i 2] "%rdx" [? [== i 3] "%rcx" [? [== i 4] "%r8" "%r9"]]]]]]]

[§ binop_code1 [b] [^ [? [== b 43] 1 [? [== b 45] 2 [? [== b 42] 3 [? [== b 47] 4 [? [== b 37] 5 [? [== b 38] 6 [? [== b 124] 7 [? [== b 60] 8 [? [== b 62] 9 -1]]]]]]]]]]]
[§ binop_code2 [b0 b1] [^ [? [&& [== b0 61] [== b1 61]] 10 [? [&& [== b0 33] [== b1 61]] 11 [? [&& [== b0 60] [== b1 61]] 12 [? [&& [== b0 62] [== b1 61]] 13 [? [&& [== b0 94] [== b1 94]] 14 [? [&& [== b0 60] [== b1 60]] 15 [? [&& [== b0 62] [== b1 62]] 16 -1]]]]]]]]]
[§ binop_classify [[$ src] hst hln] [D [! b0 [@ src hst]] [! result -1] [? [== hln 1] [! result [binop_code1 b0]] [D]] [? [== hln 2] [D [! b1 [@ src [+ hst 1]]] [! result [binop_code2 b0 b1]]] [D]] [^ result]]]

// classify_op1/2/3/4: copied verbatim from compiler.aic - same codes, same
// meaning (7=@ 8=@! 9=@@ 10=@@! 11=@@$ 12=@@$!) - reused here rather than
// reinvented so byte/word-op detection stays byte-for-byte consistent with
// the real statement-head classifier already verified in compiler.aic.
[§ classify_op1 [b] [^ [? [== b 46] 1 [? [== b 33] 2 [? [== b 63] 3 [? [== b 87] 4 [? [== b 68] 5 [? [== b 94] 6 [? [== b 64] 7 [? [== b 72] 13 [? [== b 76] 14 [? [== b 78] 15 [? [== b 86] 16 [? [== b 79] 17 [? [== b 90] 18 [? [== b 82] 19 [? [== b 75] 20 [? [== b 88] 21 -2]]]]]]]]]]]]]]]]]]
[§ classify_op2 [b0 b1] [^ [? [&& [== b0 64] [== b1 33]] 8 [? [&& [== b0 64] [== b1 64]] 9 [? [&& [== b0 194] [== b1 167]] 22 -2]]]]]
[§ classify_op3 [b0 b1 b2] [^ [? [&& [== b0 64] [&& [== b1 64] [== b2 33]]] 10 [? [&& [== b0 64] [&& [== b1 64] [== b2 36]]] 11 -2]]]]
[§ classify_op4 [b0 b1 b2 b3] [^ [? [&& [== b0 64] [&& [== b1 64] [&& [== b2 36] [== b3 33]]]] 12 -2]]]

[§ emit_byte_op [[$ tokens] [$ match] [$ src] s [$ ctx] code] [D
  [! h [@@ ctx 0]]
  [! op_tok [+ s 1]]
  [! arg1 [+ op_tok 1]]
  [! a1e [next_child_end tokens match arg1]]
  [! arg2 [+ a1e 1]]
  [? [== code 7] [D
      [emit_expr tokens match src arg1 ctx] [K h "    pushq   %rax\n"]
      [emit_expr tokens match src arg2 ctx] [K h "    movq    %rax, %rbx\n"]
      [K h "    popq    %rax\n"]
      [K h "    movzbq  (%rax,%rbx), %rax\n"]
    ] [D]]
  [? [== code 8] [D
      [! a2e [next_child_end tokens match arg2]]
      [! arg3 [+ a2e 1]]
      [emit_expr tokens match src arg1 ctx] [K h "    pushq   %rax\n"]
      [emit_expr tokens match src arg2 ctx] [K h "    pushq   %rax\n"]
      [emit_expr tokens match src arg3 ctx]
      [K h "    popq    %rbx\n"]
      [K h "    popq    %rcx\n"]
      [K h "    movb    %al, (%rcx,%rbx)\n"]
    ] [D]]
  [^ 0]
]]

[§ emit_word_op [[$ tokens] [$ match] [$ src] s [$ ctx] code] [D
  [! h [@@ ctx 0]]
  [! op_tok [+ s 1]]
  [! arg1 [+ op_tok 1]]
  [! a1e [next_child_end tokens match arg1]]
  [! arg2 [+ a1e 1]]
  [? [|| [== code 9] [== code 11]] [D
      [emit_expr tokens match src arg1 ctx] [K h "    pushq   %rax\n"]
      [emit_expr tokens match src arg2 ctx] [K h "    movq    %rax, %rbx\n"]
      [K h "    popq    %rax\n"]
      [K h "    movq    (%rax,%rbx,8), %rax\n"]
    ] [D]]
  [? [|| [== code 10] [== code 12]] [D
      [! a2e [next_child_end tokens match arg2]]
      [! arg3 [+ a2e 1]]
      [emit_expr tokens match src arg1 ctx] [K h "    pushq   %rax\n"]
      [emit_expr tokens match src arg2 ctx] [K h "    pushq   %rax\n"]
      [emit_expr tokens match src arg3 ctx]
      [K h "    popq    %rbx\n"]
      [K h "    popq    %rcx\n"]
      [K h "    movq    %rax, (%rcx,%rbx,8)\n"]
    ] [D]]
  [^ 0]
]]

// emit_call: ctx slot 4 = funcs table ptr, slot 5 = fn_param_count table
// ptr (both set up once by the driver, read here via '@@$' since they're
// pointers, not plain ints). Pushes every argument left-to-right, then
// pops into pcount registers counting DOWN from pcount-1 to 0 - the same
// "pop index tracks argument index, independent of push order" trick
// aic_codegen.py's own compile_expr uses, so argument N always lands in
// argreg_name(N) regardless of how many arguments there are.
[§ emit_call [[$ tokens] [$ match] [$ src] s [$ ctx] fi] [D
  [! h [@@ ctx 0]]
  [! funcs [@@$ ctx 4]]
  [! fpc [@@$ ctx 5]]
  [! pcount [@@ fpc fi]]
  [! name_tok [@@ funcs [+ [* fi 4] 1]]]
  [! nst [@@ tokens [+ [* name_tok 3] 1]]]
  [! nln [@@ tokens [+ [* name_tok 3] 2]]]
  [! op_tok [+ s 1]]
  [! e [@@ match s]]
  [! p [+ op_tok 1]]
  [W [< p e] [D
    [emit_expr tokens match src p ctx]
    [K h "    pushq   %rax\n"]
    [! p [+ [next_child_end tokens match p] 1]]
  ]]
  [! i [- pcount 1]]
  [W [>= i 0] [D
    [K h "    popq    "] [K h [argreg_name i]] [K h "\n"]
    [! i [- i 1]]
  ]]
  [K h "    call    aicfn_"]
  [K h [slice_str src nst nln]]
  [K h "\n"]
  [^ 0]
]]

[§ new_label_num [[$ ctx]] [D [! v [+ [@@ ctx 1] 1]] [@@! ctx 1 v] [^ v]]]

// resolve_func: scan the funcs table (ctx slot 4, count in slot 6) for a
// name matching src[hst..hst+hln) - returns its index, or -1 if no
// function has that name. Shared by emit_expr's call fallback and
// emit_stmt's statement-head fallback, so "is this a call" is answered
// identically in both contexts rather than by two copies of the same
// scan that could quietly diverge.
[§ resolve_func [[$ tokens] [$ src] hst hln [$ ctx]] [D
  [! funcs [@@$ ctx 4]]
  [! fcount [@@ ctx 6]]
  [! fi 0]
  [! found -1]
  [W [&& [== found -1] [< fi fcount]] [D
    [! nmtok [@@ funcs [+ [* fi 4] 1]]]
    [? [streq src hst hln [@@ tokens [+ [* nmtok 3] 1]] [@@ tokens [+ [* nmtok 3] 2]]] [! found fi] [D]]
    [! fi [+ fi 1]]
  ]]
  [^ found]
]]

// emit_shortcircuit: '&&'/'||', short-circuit exactly like C/JS - the
// right operand's instructions only run when the left side didn't already
// decide the result. is_and picks between the two mirror-image jump
// senses (je vs jne) and fallback values (0 vs 1), same as
// aic_codegen.py's single shared code path keyed on 'op == "&&"'.
[§ emit_shortcircuit [[$ tokens] [$ match] [$ src] s [$ ctx] is_and] [D
  [! h [@@ ctx 0]]
  [! op_tok [+ s 1]]
  [! left [+ op_tok 1]]
  [! lce [next_child_end tokens match left]]
  [! right [+ lce 1]]
  [! lbl1 [new_label_num ctx]]
  [! lbl1txt [N lbl1]]
  [! lbl2 [new_label_num ctx]]
  [! lbl2txt [N lbl2]]
  [! fallback [? is_and 0 1]]
  [! fbtxt [N fallback]]
  [emit_expr tokens match src left ctx]
  [K h "    testq   %rax, %rax\n"]
  [? is_and
    [D [K h "    je      .Lscshort"] [K h lbl1txt] [K h "\n"]]
    [D [K h "    jne      .Lscshort"] [K h lbl1txt] [K h "\n"]]]
  [emit_expr tokens match src right ctx]
  [K h "    testq   %rax, %rax\n"]
  [K h "    setne   %al\n"]
  [K h "    movzbq  %al, %rax\n"]
  [K h "    jmp     .Lscend"] [K h lbl2txt] [K h "\n"]
  [K h ".Lscshort"] [K h lbl1txt] [K h ":\n"]
  [K h "    movq    $"] [K h fbtxt] [K h ", %rax\n"]
  [K h ".Lscend"] [K h lbl2txt] [K h ":\n"]
  [^ 0]
]]

// emit_ternary: '?' used as a value ([? cond then else]) - condition,
// conditional jump to the else branch, then-branch, unconditional jump to
// end, else-branch, end label. Type-matching between the two branches is
// Analyzer.analyze's job (check_reads' _static_type comparison), not
// compile_expr's - so, like aic_codegen.py's own compile_expr, this emits
// unconditionally and trusts analysis already validated it.
[§ emit_ternary [[$ tokens] [$ match] [$ src] s [$ ctx]] [D
  [! h [@@ ctx 0]]
  [! op_tok [+ s 1]]
  [! cond [+ op_tok 1]]
  [! ce [next_child_end tokens match cond]]
  [! then_tok [+ ce 1]]
  [! te [next_child_end tokens match then_tok]]
  [! else_tok [+ te 1]]
  [! lbl1 [new_label_num ctx]]
  [! lbl1txt [N lbl1]]
  [! lbl2 [new_label_num ctx]]
  [! lbl2txt [N lbl2]]
  [emit_expr tokens match src cond ctx]
  [K h "    testq   %rax, %rax\n"]
  [K h "    je      .Lternelse"] [K h lbl1txt] [K h "\n"]
  [emit_expr tokens match src then_tok ctx]
  [K h "    jmp     .Lternend"] [K h lbl2txt] [K h "\n"]
  [K h ".Lternelse"] [K h lbl1txt] [K h ":\n"]
  [emit_expr tokens match src else_tok ctx]
  [K h ".Lternend"] [K h lbl2txt] [K h ":\n"]
  [^ 0]
]]

[§ emit_binop_tail [[$ ctx] code] [D
  [! h [@@ ctx 0]]
  [? [== code 1] [K h "    addq    %rbx, %rax\n"] [D]]
  [? [== code 2] [K h "    subq    %rbx, %rax\n"] [D]]
  [? [== code 3] [K h "    imulq   %rbx, %rax\n"] [D]]
  [? [|| [== code 4] [== code 5]] [D
      [! lbl [new_label_num ctx]]
      [! lbltxt [N lbl]]
      [K h "    testq   %rbx, %rbx\n"]
      [K h "    jne     .Ldivok"] [K h lbltxt] [K h "\n"]
      [K h "    jmp     .Ldivzero\n"]
      [K h ".Ldivok"] [K h lbltxt] [K h ":\n"]
      [K h "    cqto\n"]
      [K h "    idivq   %rbx\n"]
      [? [== code 5] [K h "    movq    %rdx, %rax\n"] [D]]
    ] [D]]
  [? [== code 6] [K h "    andq    %rbx, %rax\n"] [D]]
  [? [== code 7] [K h "    orq     %rbx, %rax\n"] [D]]
  [? [== code 14] [K h "    xorq    %rbx, %rax\n"] [D]]
  [? [== code 15] [D [K h "    movq    %rbx, %rcx\n"] [K h "    shlq    %cl, %rax\n"]] [D]]
  [? [== code 16] [D [K h "    movq    %rbx, %rcx\n"] [K h "    sarq    %cl, %rax\n"]] [D]]
  [? [== code 8] [D [K h "    cmpq    %rbx, %rax\n"] [K h "    setl    %al\n"] [K h "    movzbq  %al, %rax\n"]] [D]]
  [? [== code 9] [D [K h "    cmpq    %rbx, %rax\n"] [K h "    setg    %al\n"] [K h "    movzbq  %al, %rax\n"]] [D]]
  [? [== code 10] [D [K h "    cmpq    %rbx, %rax\n"] [K h "    sete    %al\n"] [K h "    movzbq  %al, %rax\n"]] [D]]
  [? [== code 11] [D [K h "    cmpq    %rbx, %rax\n"] [K h "    setne    %al\n"] [K h "    movzbq  %al, %rax\n"]] [D]]
  [? [== code 12] [D [K h "    cmpq    %rbx, %rax\n"] [K h "    setle    %al\n"] [K h "    movzbq  %al, %rax\n"]] [D]]
  [? [== code 13] [D [K h "    cmpq    %rbx, %rax\n"] [K h "    setge    %al\n"] [K h "    movzbq  %al, %rax\n"]] [D]]
  [? [|| [< code 1] [> code 16]] [. "CodegenError: emit_expr only supports arithmetic/comparison binary ops so far - got an unrecognized/unsupported operator"] [D]]
  [^ 0]
]]

[§ emit_expr [[$ tokens] [$ match] [$ src] s [$ ctx]] [D
  [! h [@@ ctx 0]]
  [! tag [@@ tokens [* s 3]]]
  [? [== tag 3] [D
      [! ast [@@ tokens [+ [* s 3] 1]]]
      [! aln [@@ tokens [+ [* s 3] 2]]]
      [? [is_numeric_atom src ast aln] [D
          [! v [V [slice_str src ast aln]]]
          [! vtxt [N v]]
          [K h "    movq    $"] [K h vtxt] [K h ", %rax\n"]
        ] [D
          [! decls [@@$ ctx 2]]
          [! dcount [@@ ctx 3]]
          [! idx [decl_index src decls dcount ast aln]]
          [! off [* -8 [+ idx 1]]]
          [! offtxt [N off]]
          [K h "    movq    "] [K h offtxt] [K h "(%rbp), %rax\n"]
        ]]
    ] [D
      [! op_tok [+ s 1]]
      [! hst [@@ tokens [+ [* op_tok 3] 1]]]
      [! hln [@@ tokens [+ [* op_tok 3] 2]]]
      [! b0 [@ src hst]]
      [! b1 [? [> hln 1] [@ src [+ hst 1]] 0]]
      [! is_sc_and [&& [== hln 2] [&& [== b0 38] [== b1 38]]]]
      [! is_sc_or [&& [== hln 2] [&& [== b0 124] [== b1 124]]]]
      [! opcode -2]
      [? [== hln 1] [! opcode [classify_op1 b0]] [D]]
      [? [== hln 2] [! opcode [classify_op2 b0 b1]] [D]]
      [? [== hln 3] [! opcode [classify_op3 [@ src hst] [@ src [+ hst 1]] [@ src [+ hst 2]]]] [D]]
      [? [== hln 4] [! opcode [classify_op4 [@ src hst] [@ src [+ hst 1]] [@ src [+ hst 2]] [@ src [+ hst 3]]]] [D]]
      [? [== opcode 3]
        [emit_ternary tokens match src s ctx]
        [? is_sc_and
          [emit_shortcircuit tokens match src s ctx 1]
          [? is_sc_or
            [emit_shortcircuit tokens match src s ctx 0]
            [? [|| [== opcode 7] [== opcode 8]]
              [emit_byte_op tokens match src s ctx opcode]
              [? [|| [|| [== opcode 9] [== opcode 10]] [|| [== opcode 11] [== opcode 12]]]
                [emit_word_op tokens match src s ctx opcode]
                [D
                  [! bcode [binop_classify src hst hln]]
                  [? [!= bcode -1]
                    [D
                      [! left [+ op_tok 1]]
                      [! lce [next_child_end tokens match left]]
                      [! right [+ lce 1]]
                      [emit_expr tokens match src left ctx]
                      [K h "    pushq   %rax\n"]
                      [emit_expr tokens match src right ctx]
                      [K h "    movq    %rax, %rbx\n"]
                      [K h "    popq    %rax\n"]
                      [emit_binop_tail ctx bcode]
                    ]
              [D
                [! found [resolve_func tokens src hst hln ctx]]
                [? [!= found -1]
                  [emit_call tokens match src s ctx found]
                  [. "CodegenError: emit_expr - unresolved symbol in expression position"]]
              ]]
          ]]]]]]
    ]]
]]

// emit_assign: '[! name expr]' - compile the RHS, store %rax to name's
// stack slot. Mirrors emit_expr's own atom-var-read branch exactly
// (decl_index -> offset -> N -> text), just writing instead of reading.
[§ emit_assign [[$ tokens] [$ match] [$ src] s [$ ctx]] [D
  [! h [@@ ctx 0]]
  [! op_tok [+ s 1]]
  [! name_tok [+ op_tok 1]]
  [! expr_tok [+ name_tok 1]]
  [! nst [@@ tokens [+ [* name_tok 3] 1]]]
  [! nln [@@ tokens [+ [* name_tok 3] 2]]]
  [! decls [@@$ ctx 2]]
  [! dcount [@@ ctx 3]]
  [! idx [decl_index src decls dcount nst nln]]
  [! off [* -8 [+ idx 1]]]
  [! offtxt [N off]]
  [emit_expr tokens match src expr_tok ctx]
  [K h "    movq    %rax, "] [K h offtxt] [K h "(%rbp)\n"]
  [^ 0]
]]

// emit_return: '[^ expr]' - compile expr, jump to the active epilogue
// label (ctx slot 7, a STR pointer set by the driver/caller - a real
// per-function frame with its own genuine epilogue label is Stage 9).
[§ emit_return [[$ tokens] [$ match] [$ src] s [$ ctx]] [D
  [! h [@@ ctx 0]]
  [! op_tok [+ s 1]]
  [! expr_tok [+ op_tok 1]]
  [emit_expr tokens match src expr_tok ctx]
  [K h "    jmp     "] [K h [@@$ ctx 7]] [K h "\n"]
  [^ 0]
]]

// emit_do: '[D stmt ...]' - purely sequential, no codegen of its own.
[§ emit_do [[$ tokens] [$ match] [$ src] s [$ ctx]] [D
  [! op_tok [+ s 1]]
  [! e [@@ match s]]
  [! p [+ op_tok 1]]
  [W [< p e] [D
    [emit_stmt tokens match src p ctx]
    [! p [+ [next_child_end tokens match p] 1]]
  ]]
  [^ 0]
]]

// emit_while: '[W cond stmt ...]'. Both labels allocated before the
// condition compiles, same "allocate the whole pair up front" order
// aic_codegen.py's own 'top_l, end_l = new_label(...), new_label(...)'
// uses - top_l gets the lower number.
[§ emit_while [[$ tokens] [$ match] [$ src] s [$ ctx]] [D
  [! h [@@ ctx 0]]
  [! op_tok [+ s 1]]
  [! cond [+ op_tok 1]]
  [! ce [next_child_end tokens match cond]]
  [! e [@@ match s]]
  [! lbl1 [new_label_num ctx]] [! lbl1txt [N lbl1]]
  [! lbl2 [new_label_num ctx]] [! lbl2txt [N lbl2]]
  [K h ".Lwtop"] [K h lbl1txt] [K h ":\n"]
  [emit_expr tokens match src cond ctx]
  [K h "    testq   %rax, %rax\n"]
  [K h "    je      .Lwend"] [K h lbl2txt] [K h "\n"]
  [! p [+ ce 1]]
  [W [< p e] [D
    [emit_stmt tokens match src p ctx]
    [! p [+ [next_child_end tokens match p] 1]]
  ]]
  [K h "    jmp     .Lwtop"] [K h lbl1txt] [K h "\n"]
  [K h ".Lwend"] [K h lbl2txt] [K h ":\n"]
  [^ 0]
]]

// emit_if: '[? cond then [else]]' used as a STATEMENT (as opposed to
// emit_ternary, the same symbol used as a VALUE) - else branch is
// optional, matching aic_codegen.py's 'if len(node) > 3'.
[§ emit_if [[$ tokens] [$ match] [$ src] s [$ ctx]] [D
  [! h [@@ ctx 0]]
  [! op_tok [+ s 1]]
  [! cond [+ op_tok 1]]
  [! ce [next_child_end tokens match cond]]
  [! then_tok [+ ce 1]]
  [! te [next_child_end tokens match then_tok]]
  [! e [@@ match s]]
  [! else_tok [+ te 1]]
  [! lbl1 [new_label_num ctx]] [! lbl1txt [N lbl1]]
  [! lbl2 [new_label_num ctx]] [! lbl2txt [N lbl2]]
  [emit_expr tokens match src cond ctx]
  [K h "    testq   %rax, %rax\n"]
  [K h "    je      .Lelse"] [K h lbl1txt] [K h "\n"]
  [emit_stmt tokens match src then_tok ctx]
  [K h "    jmp     .Lendif"] [K h lbl2txt] [K h "\n"]
  [K h ".Lelse"] [K h lbl1txt] [K h ":\n"]
  [? [< else_tok e] [emit_stmt tokens match src else_tok ctx] [D]]
  [K h ".Lendif"] [K h lbl2txt] [K h ":\n"]
  [^ 0]
]]

// emit_stmt: top-level statement dispatch, off the same classify_op1..4
// codes emit_expr's dual-role '?' already uses. A non-list node (tag !=
// 1) is a no-op here, mirroring aic_codegen.py's own compile_stmt guard
// ('if not isinstance(node, list) ... return'). Byte/word ops and
// function calls delegate straight to emit_byte_op/emit_word_op/
// emit_call - not emit_expr's full dispatch - specifically to AVOID
// emit_expr's binop_classify fallback: a bare '[+ 1 2]' at statement
// position must be rejected, never silently compiled as if it were a
// value nobody uses, matching compile_stmt's own final 'else: raise'.
[§ emit_stmt [[$ tokens] [$ match] [$ src] s [$ ctx]] [D
  [! tag [@@ tokens [* s 3]]]
  [? [!= tag 1] [D] [D
    [! op_tok [+ s 1]]
    [! hst [@@ tokens [+ [* op_tok 3] 1]]]
    [! hln [@@ tokens [+ [* op_tok 3] 2]]]
    [! opcode -2]
    [? [== hln 1] [! opcode [classify_op1 [@ src hst]]] [D]]
    [? [== hln 2] [! opcode [classify_op2 [@ src hst] [@ src [+ hst 1]]]] [D]]
    [? [== hln 3] [! opcode [classify_op3 [@ src hst] [@ src [+ hst 1]] [@ src [+ hst 2]]]] [D]]
    [? [== hln 4] [! opcode [classify_op4 [@ src hst] [@ src [+ hst 1]] [@ src [+ hst 2]] [@ src [+ hst 3]]]] [D]]
    [? [== opcode 2] [emit_assign tokens match src s ctx]
      [? [== opcode 6] [emit_return tokens match src s ctx]
        [? [== opcode 3] [emit_if tokens match src s ctx]
          [? [== opcode 4] [emit_while tokens match src s ctx]
            [? [== opcode 5] [emit_do tokens match src s ctx]
              [? [|| [== opcode 7] [|| [== opcode 8] [|| [== opcode 9] [|| [== opcode 10] [|| [== opcode 11] [== opcode 12]]]]]]
                [emit_expr tokens match src s ctx]
                [? [|| [== opcode 1] [&& [>= opcode 13] [<= opcode 21]]]
                  [. "CodegenError: emit_stmt - dot and libc-op statements aren't implemented yet (Stage 8 scope)"]
                  [D
                    [! found [resolve_func tokens src hst hln ctx]]
                    [? [!= found -1]
                      [emit_call tokens match src s ctx found]
                      [. "CodegenError: emit_stmt - unsupported statement head"]]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    ]
  ]]
  [^ 0]
]]

// --- driver: tokenize stage8_src.aic (same tokenizer compiler.aic uses) --
[! h [O "stage8_src.aic" "r"]]
[! n [Z h]]
[! src [R h n]]
[! tokens [H [* [+ n 1] 24]]]
[! i 0]
[! tok_count 0]
[! in_comment 0]
[! in_string 0]
[! string_start 0]
[! atom_start 0]
[! c 0]
[W [< i n] [! c [@ src i]] [? in_comment [D [? [== c 10] [! in_comment 0] [D]] [! i [+ i 1]]] [? in_string [? [== c 34] [D [! tok_count [write_token tokens tok_count 4 string_start [- i string_start]]] [! tok_count [+ tok_count 1]] [! in_string 0] [! i [+ i 1]]] [! i [+ i 1]]] [? [|| [== c 91] [== c 93]] [D [! tok_count [write_token tokens tok_count [? [== c 91] 1 2] i 1]] [! tok_count [+ tok_count 1]] [! i [+ i 1]]] [? [== c 34] [D [! in_string 1] [! string_start [+ i 1]] [! i [+ i 1]]] [? [&& [== c 47] [&& [< [+ i 1] n] [== [@ src [+ i 1]] 47]]] [D [! in_comment 1] [! i [+ i 2]]] [? [is_space c] [! i [+ i 1]] [D [! atom_start i] [W [&& [< i n] [is_atom_char [@ src i]]] [! i [+ i 1]]] [! tok_count [write_token tokens tok_count 3 atom_start [- i atom_start]]] [! tok_count [+ tok_count 1]]]]]]]]]]
[X h]

[! stack [H [* tok_count 8]]]
[! match [H [* tok_count 8]]]
[! sp 0]
[! k 0]
[! tag 0]
[! j 0]
[W [< j tok_count] [! tag [@@ tokens [* j 3]]] [? [== tag 1] [D [@@! stack sp j] [! sp [+ sp 1]]] [? [== tag 2] [D [! sp [- sp 1]] [! k [@@ stack sp]] [@@! match k j] [@@! match j k]] [D]]] [! j [+ j 1]]]

// stage-3-lite: split top-level forms into funcs vs mains - copied
// verbatim from compiler.aic's own (already-verified) stage 3, since a
// call site now needs to tell "this top-level form is a function def, its
// body is NOT something emit_expr should ever be pointed at" apart from
// "this is a main statement" the exact same way the real compiler does.
[! funcs [H [* [+ tok_count 1] 32]]]
[! mains [H [* [+ tok_count 1] 16]]]
[! func_count 0]
[! main_count 0]
[! form_end 0]
[! name_tok 0]
[! params_open_tok 0]
[! j 0]
[W [< j tok_count] [! tag [@@ tokens [* j 3]]] [? [== tag 1] [D [! form_end [@@ match j]] [! name_tok [+ j 2]] [? [is_section tokens src [+ j 1]] [D [? [== [@@ tokens [* name_tok 3]] 1] [! params_open_tok [+ [@@ match name_tok] 1]] [! params_open_tok [+ name_tok 1]]] [@@! funcs [* func_count 4] j] [@@! funcs [+ [* func_count 4] 1] name_tok] [@@! funcs [+ [* func_count 4] 2] params_open_tok] [@@! funcs [+ [* func_count 4] 3] form_end] [! func_count [+ func_count 1]]] [D [@@! mains [* main_count 2] j] [@@! mains [+ [* main_count 2] 1] form_end] [! main_count [+ main_count 1]]]] [! j [+ form_end 1]]] [D [@@! mains [* main_count 2] j] [@@! mains [+ [* main_count 2] 1] j] [! main_count [+ main_count 1]] [! j [+ j 1]]]]]

// call-site param counts, one per func record - only the count is needed
// to know how many argument registers to pop into (see count_params).
[! fn_param_count [H [* [+ func_count 1] 8]]]
[! fi 0]
[W [< fi func_count] [D [! po [@@ funcs [+ [* fi 4] 2]]] [@@! fn_param_count fi [count_params tokens match po]] [! fi [+ fi 1]]] ]

// collect declared names: every '[' '!' <atom> ...] form that IS one of
// main's own top-level statements (mains[mi]) - never descends into a
// function body, so a local inside e.g. 'add' can never leak into main's
// slot table, matching Analyzer.analyze's own per-scope declared sets.
[! decls [H [* [+ tok_count 1] 16]]]
[! decl_count 0]
[! mi 0]
[! mstart 0]
[W [< mi main_count] [D
  [! mstart [@@ mains [* mi 2]]]
  [? [&& [== [@@ tokens [* mstart 3]] 1] [&& [< [+ mstart 1] tok_count] [&& [== [@@ tokens [* [+ mstart 1] 3]] 3] [&& [== [@@ tokens [+ [* [+ mstart 1] 3] 2]] 1] [== [@ src [@@ tokens [+ [* [+ mstart 1] 3] 1]]] 33]]]]]
    [! decl_count [decl_add src decls decl_count [@@ tokens [+ [* [+ mstart 2] 3] 1]] [@@ tokens [+ [* [+ mstart 2] 3] 2]]]]
    [D]]
  [! mi [+ mi 1]]
]]
[. "DECL_COUNT" decl_count]
[. "FUNC_COUNT" func_count]
[sort_decls src decls 0 decl_count]

// build ctx = {handle, label_n, decls_ptr, decl_count, funcs_ptr,
// fn_param_count_ptr, func_count, epilogue_label_ptr}
[! outh [O "stage8_out.s" "w"]]
[! ctx [H 64]]
[@@! ctx 0 outh]
[@@! ctx 1 0]
[@@$! ctx 2 decls]
[@@! ctx 3 decl_count]
[@@$! ctx 4 funcs]
[@@$! ctx 5 fn_param_count]
[@@! ctx 6 func_count]
[@@$! ctx 7 ".Lret_test"]

// walk each of main's own top-level statements and emit it - any
// statement kind now, not just '!' (that restriction was Stage 7's,
// since it only ever compiled expressions; emit_stmt handles the rest)
[! stmt_count 0]
[! mi 0]
[W [< mi main_count] [D
  [! mstart [@@ mains [* mi 2]]]
  [emit_stmt tokens match src mstart ctx]
  [! stmt_count [+ stmt_count 1]]
  [! mi [+ mi 1]]
]]
[X outh]
[. "STMT_COUNT" stmt_count]
[. "LABELS_USED" [@@ ctx 1]]
