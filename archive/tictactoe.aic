// Tic-Tac-Toe: 2-Player Console Game in pure AIC

[§ check_line [b i1 i2 i3] [D
  [! v1 [@ b i1]]
  [! v2 [@ b i2]]
  [! v3 [@ b i3]]
  [? [&& [!= v1 0] [&& [== v1 v2] [== v2 v3]]] [^ v1] [^ 0]]
]]

[§ check_winner [b] [D
  [! w [check_line b 0 1 2]]
  [? [!= w 0] [^ w] [D]]
  [! w [check_line b 3 4 5]]
  [? [!= w 0] [^ w] [D]]
  [! w [check_line b 6 7 8]]
  [? [!= w 0] [^ w] [D]]
  [! w [check_line b 0 3 6]]
  [? [!= w 0] [^ w] [D]]
  [! w [check_line b 1 4 7]]
  [? [!= w 0] [^ w] [D]]
  [! w [check_line b 2 5 8]]
  [? [!= w 0] [^ w] [D]]
  [! w [check_line b 0 4 8]]
  [? [!= w 0] [^ w] [D]]
  [! w [check_line b 2 4 6]]
  [? [!= w 0] [^ w] [D]]
  [^ 0]
]]

[§ show_board [b] [D
  [! s0 [? [== [@ b 0] 88] "X" [? [== [@ b 0] 79] "O" "1"]]]
  [! s1 [? [== [@ b 1] 88] "X" [? [== [@ b 1] 79] "O" "2"]]]
  [! s2 [? [== [@ b 2] 88] "X" [? [== [@ b 2] 79] "O" "3"]]]
  [! s3 [? [== [@ b 3] 88] "X" [? [== [@ b 3] 79] "O" "4"]]]
  [! s4 [? [== [@ b 4] 88] "X" [? [== [@ b 4] 79] "O" "5"]]]
  [! s5 [? [== [@ b 5] 88] "X" [? [== [@ b 5] 79] "O" "6"]]]
  [! s6 [? [== [@ b 6] 88] "X" [? [== [@ b 6] 79] "O" "7"]]]
  [! s7 [? [== [@ b 7] 88] "X" [? [== [@ b 7] 79] "O" "8"]]]
  [! s8 [? [== [@ b 8] 88] "X" [? [== [@ b 8] 79] "O" "9"]]]
  [. ""]
  [. " " s0 " | " s1 " | " s2]
  [. "- - -+- - -+- - -"]
  [. " " s3 " | " s4 " | " s5]
  [. "- - -+- - -+- - -"]
  [. " " s6 " | " s7 " | " s8]
  [. ""]
  [^ 0]
]]

[. "=================================="]
[. "  WELCOME TO AIC TIC-TAC-TOE!     "]
[. "  2-Player Console Edition        "]
[. "=================================="]

[! board [H 9]]
[! turn 0]
[! moves 0]
[! game_over 0]

[W [== game_over 0] [D
  [show_board board]
  [! sym [? [== turn 0] 88 79]]
  [! sym_name [? [== turn 0] "X" "O"]]
  [! prompt [? [== turn 0] "Player X (1-9): " "Player O (1-9): "]]
  [! input_str [I prompt]]
  [! pos_1based [V input_str]]
  [! idx [- pos_1based 1]]
  [? [|| [< idx 0] [> idx 8]]
    [D [. "Invalid position! Choose 1-9."]]
    [D
      [! current_val [@ board idx]]
      [? [!= current_val 0]
        [D [. "Spot already taken! Choose another."]]
        [D
          [@! board idx sym]
          [! moves [+ moves 1]]
          [! win [check_winner board]]
          [? [!= win 0]
            [D
              [show_board board]
              [. "Player" sym_name "WINS!"]
              [! game_over 1]
            ]
            [D
              [? [== moves 9]
                [D
                  [show_board board]
                  [. "Game is a DRAW!"]
                  [! game_over 1]
                ]
                [D [! turn [- 1 turn]]]
              ]
            ]
          ]
        ]
      ]
    ]
  ]
]]
[. "Thanks for playing AIC Tic-Tac-Toe!"]
