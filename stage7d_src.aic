[§ getconst [] [^ 42]]
[§ double [x] [^ [* x 2]]]
[§ add [a b] [^ [+ a b]]]
[§ clamp [x lo hi] [^ [? [< x lo] lo [? [> x hi] hi x]]]]

[! buf 100]
[! i 2]
[! v 65]
[! r1 [@ buf i]]
[! r2 [@! buf i v]]
[! r3 [@@ buf i]]
[! r4 [@@! buf i v]]
[! r5 [@@$ buf i]]
[! r6 [@@$! buf i v]]
[! r7 [+ [@ buf i] [@@ buf [+ i 1]]]]
[! c0 [getconst]]
[! c1 [double v]]
[! c2 [add i v]]
[! c3 [clamp r1 0 10]]
[! c4 [+ [add c1 c2] [double c0]]]
[! c5 [add [@ buf i] [double [add i v]]]]
[! t1 [&& [< i v] [> v 0]]]
[! t2 [|| [== i 0] [== v 65]]]
[! t3 [? [< i v] i v]]
[! t4 [&& [< i 100] [== [@ buf i] v]]]
[! t5 [? [< i 0] 0 [? [> i 10] 10 i]]]
[! t6 [? t1 [add i v] [double v]]]
[! t7 [&& [|| [== i 0] [== i 2]] [!= v 0]]]
